DB_NAME=database_name
DB_USER=database_user
DB_PASSWORD=database_password

# DBngin defaults to 127.0.0.1 on port 3306. Use 127.0.0.1 rather than localhost —
# localhost can resolve to a socket that is not there on Windows.
DB_HOST=127.0.0.1:3306
DB_PREFIX=g4z_

# Optionally use a DSN instead of the DB_* variables above.
# DATABASE_URL='mysql://database_user:database_password@database_host:database_port/database_name'

WP_ENV=development

# Keep local hostnames on a .test TLD. ACF ignores .test / .local / .loc / .localhost
# and stage.* / staging.* when counting licence activations, so local sites are free.
# Any other local hostname is treated as production and burns an activation.
WP_BASE=example.test
WP_HOME=http://${WP_BASE}
WP_SITEURL=${WP_HOME}/wp

# Optional debug log path
# WP_DEBUG_LOG='/path/to/debug.log'

# Advanced Custom Fields PRO — runtime activation only.
# Composer downloads the package with separate HTTP-basic credentials, configured
# once per machine and never stored in a repo:
#   composer config --global http-basic.connect.advancedcustomfields.com <KEY> http://localhost
ACF_PRO_LICENSE=

# Google reCAPTCHA — https://www.google.com/recaptcha/admin/create
RECAPTCHA_SITEKEY=generateme
RECAPTCHA_SECRET=generateme

# TinyPNG
TINY_API_KEY=generateme

# WP Rocket
# WP_CACHE turns on advanced-cache.php, and therefore the page cache and every
# buffer-based optimisation. Defaults to true; development overrides it to false.
# WP_CACHE=true
WP_ROCKET_EMAIL=
WP_ROCKET_KEY=

# Debug
DEBUG_EMAIL=

# G4Z Watchdog
G4Z_WATCHDOG_API_KEY=
G4Z_WATCHDOG_PORTAL_URL=https://portal.g4zdev.com

# Secret keys — append with: composer generate-salts >> .env
